{
    "vstgui-ui-description": {
        "version": "1",
        "bitmaps": {},
        "fonts": {},
        "colors": {
            "Background": "#ff0000ff"
        },
        "control-tags": {},
        "custom": {},
        "templates": {
            "view": {
                "attributes": {
                    "background-color": "Background",
                    "background-color-draw-style": "filled",
                    "class": "CViewContainer",
                    "mouse-enabled": "true",
                    "opacity": "1",
                    "origin": "0, 0",
                    "size": "1200, 300",
                    "transparent": "false",
                    "wants-focus": "false"
                },
                "children": {
                    "TimelineControl": {
                        "attributes": {
                            "class": "TimelineControl",
                            "origin": "0, 0",
                            "size": "1200, 300",
                            "timelineBox": "0, 0, 1200, 200",
                            "filePathBox": "0, 0, 200, 20",
                            "holdIndicatorBox": "0, 180, 60, 200",
                            "deClickerBox": "1140, 180, 1200, 200"
                        }
                    },
                    "AutoPlayControl": {
                        "attributes": {
                            "class": "AutoPlayControl",
                            "origin": "0, 200",
                            "size": "400, 100",
                            "rept": "10, 210, 90, 290",
                            "back": "110, 210, 190, 290",
                            "stop": "210, 210, 290, 290",
                            "play": "310, 210, 390, 290"
                        }
                    },
                    "XFaderControl": {
                        "attributes": {
                            "class": "XFaderControl",
                            "origin": "800, 200",
                            "size": "400, 100",
                            "rangeBox": "810, 210, 1090, 290"
                        }
                    },
                    "XFaderCurveControl": {
                        "attributes": {
                            "class": "XFaderCurveControl",
                            "origin": "1100, 200",
                            "size": "100, 100",
                            "curveBox": "1110, 210, 1190, 290"
                        }
                    }
                }
            }
        }
    }
}
